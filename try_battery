def check_lithium_balance(sol, model):
    g = model.geo
    p = model.param
    s = model.sim

    # Volume weights for spherical particle shells
    def sphere_weights(R, N):
        faces = np.linspace(0.0, R, N + 1)
        return np.diff(faces**3) / R**3

    w_n = sphere_weights(g.R_n, g.N_r_n)
    w_p = sphere_weights(g.R_p, g.N_r_p)

    # Volume-averaged solid concentrations [mol/m^3]
    c_n_avg = w_n @ sol.y[model.s_n, :]
    c_p_avg = w_p @ sol.y[model.s_p, :]

    # Lithium inventory in each electrode [C]
    Q_n = (
        p.F * s.A_cell * g.L_n
        * (1.0 - g.eps_n) * c_n_avg
    )

    Q_p = (
        p.F * s.A_cell * g.L_p
        * (1.0 - g.eps_p) * c_p_avg
    )

    # Cumulative lithium loss due to SEI [C]
    Q_loss = sol.y[model.i_Q, :]

    # Conservation: Q_n + Q_p + Q_loss = constant
    Q_total = Q_n + Q_p + Q_loss
    error = Q_total - Q_total[0]

    print("Anode lithium change [C]:",
          Q_n[-1] - Q_n[0])

    print("Cathode lithium change [C]:",
          Q_p[-1] - Q_p[0])

    print("SEI lithium loss [C]:",
          Q_loss[-1] - Q_loss[0])

    print("Final balance error [C]:", error[-1])
    print("Maximum absolute error [C]:",
          np.max(np.abs(error)))

    return error

balance_error = check_lithium_balance(solution, model)

