import numpy as np
import matplotlib.pyplot as plt

from backend.physics.config import BatteryGeometry, BatteryParameters, SimulationConfig
from backend.physics.simulation import BatterySimulation

geo = BatteryGeometry()
param = BatteryParameters()
sim = SimulationConfig()

model = BatterySimulation(
    geo,
    param,
    sim,
    enable_sei=True,
    enable_thermal=False
)

# 50 cycles

data = model.run_cycles(
    n_cycles=50,
    charge_time=3600.0,
    discharge_time=3600.0,
    current_density=2.5
)

print("Final voltage:", data["voltage_V"][-1])
print("Final SEI thickness [nm]:", data["sei_thickness_m"][-1] * 1e9)
print("Lithium loss [Ah]:", data["capacity_loss_Ah"][-1])

def plot_cycling_results(data):

    time_h = data["time_s"] / 3600.0

    # Voltage
    fig, ax = plt.subplots(figsize=(11, 5))
    ax.plot(time_h, data["voltage_V"])
    ax.set(
        xlabel="Time [h]",
        ylabel="Voltage [V]",
        title="Charge-discharge cycling"
    )
    ax.grid(True)

    # SEI growth
    fig, ax = plt.subplots(figsize=(11, 5))
    ax.plot(
        time_h,
        data["sei_thickness_m"] * 1e9
    )
    ax.set(
        xlabel="Time [h]",
        ylabel="SEI thickness [nm]",
        title="SEI growth during cycling"
    )
    ax.grid(True)

    plt.show()

plot_cycling_results(data)