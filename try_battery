import numpy as np
import matplotlib.pyplot as plt

from backend.physics.config import BatteryGeometry, BatteryParameters, SimulationConfig
from backend.physics.simulation import BatterySimulation

geo = BatteryGeometry()
param = BatteryParameters()
sim = SimulationConfig()

model = BatterySimulation(
    geo,
    param,
    sim,
    enable_sei=True,
    enable_thermal=False
)

# 100 cycles

data = model.run_cycles(
    n_cycles = 100,
    charge_time = 3600.0,
    discharge_time = 3600.0,
    current_density = 2.5,
    V_max=3.65,
    V_min=3.59,
)

summary = data["cycle_summary"]

plt.figure(figsize=(9, 5))

plt.plot(
    summary["cycle"],
    summary["SOH_percent"],
)

plt.xlabel("Cycle number")
plt.ylabel("Relative SOH [%]")
plt.title("Capacity retention during cycling")
plt.grid(True)
plt.show()